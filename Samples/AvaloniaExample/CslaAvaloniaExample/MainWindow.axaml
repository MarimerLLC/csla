<Window
    x:Class="CslaAvaloniaExample.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CSLA Avalonia Example"
    Width="900"
    Height="600"
    MinWidth="640"
    MinHeight="420">

  <TabControl Margin="12">
    <TabItem Header="Person Edit">
      <ContentControl x:Name="PersonEditHost" />
    </TabItem>

    <TabItem Header="Person List">
      <ContentControl x:Name="PersonListHost" />
    </TabItem>
  </TabControl>
</Window>
