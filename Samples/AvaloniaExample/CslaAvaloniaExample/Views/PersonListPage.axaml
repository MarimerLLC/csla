<ContentPage xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vms="clr-namespace:CslaAvaloniaExample.ViewModels"
        xmlns:models="clr-namespace:BusinessLibrary;assembly=BusinessLibrary"
        x:Class="CslaAvaloniaExample.Views.PersonListPage"
        Header="PersonListPage">
  
  <Grid>
    <ListBox ItemsSource="{Binding PersonListViewModel}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto, *">
            <Label Content="{Binding Name, x:DataType=models:PersonInfo}" Width="100" Margin="5" />
            <Button Content="Edit" Click="EditPerson"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</ContentPage>
