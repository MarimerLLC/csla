<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net472;net48;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Set CslaVersion (as an environment variable, so the projects BenchmarkDotNet generates see it too) to benchmark a locally packed Csla package. -->
    <CslaVersion Condition="'$(CslaVersion)' == ''">10.2.0</CslaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Csla" Version="$(CslaVersion)" />
    <!-- CSLA 11 ships the generators inside the Csla package -->
    <PackageReference Include="Csla.Generator.AutoImplementProperties.CSharp" Version="$(CslaVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      Condition="$([System.Int32]::Parse($(CslaVersion.Split('.')[0]))) &lt; 11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.1" />

  </ItemGroup>

  <!-- Not-null properties (#5047) exist from CSLA 11 on -->
  <ItemGroup Condition="$([System.Int32]::Parse($(CslaVersion.Split('.')[0]))) &lt; 11">
    <Compile Remove="NotNullInvariant\NotNullGraphBenchmark.cs" />
  </ItemGroup>
</Project>
