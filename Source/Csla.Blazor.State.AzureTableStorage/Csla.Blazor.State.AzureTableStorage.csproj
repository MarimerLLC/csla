<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Directory.Package.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Product>CSLA .NET Azure Table Storage session store</Product>
    <Description>Azure Table Storage implementation of the CSLA .NET ISessionStore for Blazor server/WASM state.</Description>
    <SignAssembly>true</SignAssembly>
    <BaseOutputPath>..\..\Bin</BaseOutputPath>
    <Title>CSLA .NET Azure Table Storage session store</Title>
    <PackageTags>CSLA;Azure;Table Storage;Session;Blazor;State</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Csla\Csla.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Csla.Blazor.State.AzureTableStorage.Tests" Key="" />
  </ItemGroup>

</Project>
