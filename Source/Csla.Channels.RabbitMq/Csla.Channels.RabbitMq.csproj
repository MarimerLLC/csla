<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Directory.Package.props" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0;net11.0</TargetFrameworks>
    <Product>CSLA .NET RabbitMQ Channel</Product>
    <Description>RabbitMQ data portal channel for CSLA .NET.</Description>
    <SignAssembly>true</SignAssembly>
    <BaseOutputPath>..\..\Bin</BaseOutputPath>
    <Title>CSLA .NET RabbitMQ data portal channel</Title>
    <PackageTags>CSLA;RabbitMQ</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>
    <!--
      No trim or AOT warnings are suppressed project-wide. Fix the code or annotate the API instead;
      use UnconditionalSuppressMessage with a justification only where the requirement provably holds.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.0.0" />
    <PackageReference Include="Polyfill" Version="9.22.0" PrivateAssets="all" />
    <ProjectReference Include="..\Csla\Csla.csproj" />
  </ItemGroup>

  <!-- Csla's netstandard2.0 build is compiled against Microsoft.Bcl.AsyncInterfaces 10.0.15 (through
       Microsoft.Extensions.DependencyInjection), but this project's netstandard2.1 package graph resolves it
       to 8.0.0 (through System.Text.Json 8.0.5 and RabbitMQ.Client), which causes MSB3277. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" />
  </ItemGroup>

</Project>
