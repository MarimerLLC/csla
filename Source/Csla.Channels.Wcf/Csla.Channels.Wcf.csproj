<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Directory.Package.props" />

  <PropertyGroup>
    <TargetFrameworks>net462;net472;net48;net10.0;net11.0</TargetFrameworks>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>CSLA .NET WCF Channel</Product>
    <Description>WCF data portal channel for CSLA .NET.</Description>
    <SignAssembly>true</SignAssembly>
    <BaseOutputPath>..\..\Bin</BaseOutputPath>
    <Title>CSLA .NET WCF data portal channel</Title>
    <PackageTags>CSLA;WCF</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Csla\Csla.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith(&quot;net4&quot;))">
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceModel.Activation" />
  </ItemGroup>

  <!-- CoreWCF libraries are only needed for modern .net targets. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0' or '$(TargetFramework)'=='net11.0'">
    <PackageReference Include="CoreWCF.Http" Version="1.8.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.8.1" />
  </ItemGroup>

  <!-- There is no 11.x version of the client side System.ServiceModel packages, so .NET 11 uses the 10.x version. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0' or '$(TargetFramework)'=='net11.0'">
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
  </ItemGroup>

  <!-- CoreWCF and System.ServiceModel.Primitives pull in versions of System.Security.Cryptography.Xml
       that have known high severity advisories (NU1903), so reference a patched version of the package
       from the servicing band that matches each target framework. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net11.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

</Project>
