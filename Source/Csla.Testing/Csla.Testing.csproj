<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Directory.Package.props" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Csla.Testing</AssemblyName>
    <RootNamespace>Csla.Testing</RootNamespace>
    <PackageId>Csla.Testing</PackageId>
    <Product>CSLA .NET Testing</Product>
    <Title>CSLA .NET Testing</Title>
    <Description>Supporting types for unit testing CSLA .NET business classes, business rules, and other business logic. This package is intended for use in test projects; it is not required by, or intended for use in, production application code.</Description>
    <PackageTags>CSLA;Business;Rules;Testing;UnitTesting</PackageTags>
    <DelaySign>false</DelaySign>
    <SignAssembly>true</SignAssembly>
    <BaseOutputPath>..\..\Bin</BaseOutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>
    <!--
      No trim or AOT warnings are suppressed project-wide. Fix the code or annotate the API instead;
      use UnconditionalSuppressMessage with a justification only where the requirement provably holds.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Csla\Csla.csproj" />
    <PackageReference Include="Polyfill" Version="9.22.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net11.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

</Project>
